{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CircuitBreaker": {
    "FailureRatio": 0.5,
    "MinimumThroughput": 3,
    "SamplingSeconds": 10,
    "BreakSeconds": 15,
    "TimeoutSeconds": 2
  },
  "Retry": {
    "MaxRetryAttempts": 2,
    "DelayMilliseconds": 200,
    "TotalTimeoutSeconds": 8
  },
  "Cache": {
    "TtlSeconds": 30
  },
  "ConnectionStrings": {
    "Redis": "redis:6379,abortConnect=false,connectTimeout=1000,syncTimeout=1000",
    "Db": "Host=projects-db;Database=projects;Username=app;Password=app"
  },
  "Services": {
    "Users": "http://usermanager:8080"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "mini-gestor-proyectos",
    "Audience": "mini-gestor-proyectos"
  }
}
