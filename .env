# ─── Variables compartidas por docker-compose ────────────────────────────────
# Secreto para firmar/validar los JWT. TODOS los componentes lo comparten para
# poder validar el token de forma local (servicios sin estado).
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-chars
JWT_ISSUER=mini-gestor-proyectos
JWT_AUDIENCE=mini-gestor-proyectos

# Puerto público del gateway (único punto de entrada del sistema)
GATEWAY_PORT=8080

# Credenciales de las bases PostgreSQL (una por componente)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
USERS_DB=users
PROJECTS_DB=projects
TASKS_DB=tasks
